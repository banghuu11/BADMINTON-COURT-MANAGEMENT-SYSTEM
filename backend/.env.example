# VNPay sandbox (lấy từ tài khoản merchant sandbox của VNPay)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_HOST=https://sandbox.vnpayment.vn
# Backend phải public khi demo ngoài localhost (dùng ngrok/Cloudflare Tunnel nếu cần)
VNPAY_RETURN_URL=http://localhost:8080/api/payment/vnpay-return
FRONTEND_URL=http://localhost:5173

# SePay Payment Gateway sandbox
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Một IPN dùng chung cho thanh toán đặt sân và mua gói
# URL này phải là HTTPS public và được cấu hình trong trang quản lý SePay
SEPAY_IPN_URL=https://your-public-domain.example/api/payment/sepay/ipn
# Chỉ bật khi thực sự cần luồng thanh toán giả lập cũ
PAYMENT_MOCK_ENABLED=false
